# Verplicht: jouw eigen Anthropic API-key
ANTHROPIC_API_KEY=sk-ant-...

# Optioneel — standaardwaarden zijn prima om mee te beginnen
ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=3000

# Kostenbeheersing
DAILY_GENERATE_CAP=300
PER_IP_HOURLY_CAP=20

# Tips in de wachtcarrousel: kleine AI-verzoeken (8 tips per keer), alleen terwijl
# iemand de carrousel bekijkt. Eigen limieten, los van de generatielimieten hierboven.
TIPS_PER_IP_HOURLY=40
DAILY_TIPS_CAP=500
# Optioneel: een sneller/goedkoper model voor de tips. Leeg = hetzelfde model als voor gerechten.
ANTHROPIC_TIPS_MODEL=

# Optioneel: gerechtfoto's (gratis Unsplash-sleutel, https://unsplash.com/developers)
# Leeg laten = app werkt gewoon door, alleen zonder foto's.
UNSPLASH_ACCESS_KEY=

# Sterk aanbevolen voor een echte deployment (bijv. Render): blijvende opslag.
# Zonder dit wordt lokaal opgeslagen, en gaat alle data verloren bij elke
# herstart/redeploy (o.a. op Render's gratis laag, die na 15 min inactiviteit
# herstart). Gratis account op https://www.mongodb.com/cloud/atlas/register
MONGODB_URI=
MONGODB_DB=weekmenu

# Optioneel: nodig voor "Wachtwoord vergeten" e-mails. Gratis account op
# https://resend.com (3000 e-mails/maand gratis, geen creditcard nodig).
# Zonder een geverifieerd eigen domein kun je met de standaard RESEND_FROM
# hieronder alleen naar je eigen, bij Resend geverifieerde e-mailadres sturen
# (prima voor een kleine testgroep — voor bredere verspreiding: verifieer een
# eigen domein bij Resend en zet RESEND_FROM op iets als "Balanza <noreply@jouwdomein.nl>").
RESEND_API_KEY=
RESEND_FROM=Balanza <onboarding@resend.dev>

# Optioneel: geeft jou toegang tot /admin — een eenvoudige, wachtwoord-
# beveiligde pagina om te zien wie de app gebruikt (voorkeuren, aantal
# opgeslagen gerechten, geplande weken). Leeg laten = /admin geeft een
# foutmelding, verder werkt de app gewoon door.
ADMIN_PASSWORD=

# Optioneel: het import-adres van Bring! (staat standaard op het adres uit de Bring! Import Developer Guide).
# Alleen invullen als Bring! dat adres ooit wijzigt.
BRING_IMPORT_ENDPOINT=

# Optioneel: pushmeldingen ("je gerechten zijn klaar") voor als iemand naar een andere app gaat tijdens het genereren.
# Zonder deze regels maakt de server zelf een sleutelpaar en bewaart dat in de database (met MONGODB_URI blijft het bestaan;
# zonder verdwijnt het bij elke herstart). Voor een vaste opzet: maak een paar (commando in de README, sectie
# "Genereren op de achtergrond en meldingen") en zet het hier. Houd de privésleutel geheim.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Een mailto:- of https://-adres waarmee pushdiensten je kunnen bereiken. Leeg = het adres van je site.
VAPID_SUBJECT=

# Optioneel: genereren op de achtergrond (standaardwaarden zijn prima).
# Hoe lang een klaar resultaat blijft staan, hoe lang een opdracht hooguit mag duren, en hoe kort geleden de app
# gepeild moet hebben om te tellen als "kijkt nog mee" (dan sturen we geen melding). Alle drie in milliseconden.
JOB_TTL_MS=1800000
JOB_MAX_RUN_MS=600000
JOB_WATCH_MS=20000

# Optioneel: een ander adres voor de Anthropic API (bijv. een eigen proxy). Leeg = het standaardadres.
ANTHROPIC_BASE_URL=

# Optioneel: nieuwe gerechten per gebruiker per maand. 0 = onbeperkt (standaard). Kan ook in de beheerconsole worden ingesteld,
# en per gebruiker afwijken. Zie de README, sectie "Kosten, tokens en de maandlimiet".
MONTHLY_DISH_CAP=0

# Optioneel: prijs per miljoen tokens in dollars, waarmee de kosten in de beheerconsole worden berekend.
# Standaard de prijs van Claude Sonnet 4.6 ($3 in, $15 uit). Pas aan als je een ander model gebruikt.
PRICE_IN_PER_M=3
PRICE_OUT_PER_M=15
# Alleen nodig als ANTHROPIC_TIPS_MODEL een ander model is dan ANTHROPIC_MODEL (leeg = dezelfde prijs).
TIPS_PRICE_IN_PER_M=
TIPS_PRICE_OUT_PER_M=

# Optioneel en standaard uit: abonnementen (Balanza Plus) via Mollie. Zie de README, sectie "Betalingen en abonnementen".
# Begin met een testsleutel (test_...). PUBLIC_BASE_URL is het adres van je app zonder slash aan het eind; Mollie stuurt daar
# betaalmeldingen naartoe en klanten keren daar naar terug. Daarna zet je abonnementen aan in Beheer -> Instellingen.
MOLLIE_API_KEY=
PUBLIC_BASE_URL=
